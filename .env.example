# NEXUS CORE 2.0 — Production & Development Environment Configuration
# Copy this file to .env and configure your variables.

# ===== Server Settings =====
HOST=0.0.0.0
PORT=8000
DEBUG=false
AUTH_REQUIRED=false
NEXUS_API_TOKEN=

# ===== Database Configuration (Dual-Mode: SQLite WAL / PostgreSQL) =====
# Default: SQLite with WAL mode and foreign key constraints
DATABASE_URL=sqlite:///~/.nexus-core-2.0/nexus_2.db
# PostgreSQL Connection String (Production cluster mode):
# DATABASE_URL=postgresql://nexus_user:nexus_password@postgres:5432/nexus_core_db

# ===== LLM Planner Gateway (OpenAI-compatible) =====
# Local LLM Gateway (e.g. gemini-3.8-flash-medium on port 8045):
PLANNER_BASE_URL=http://127.0.0.1:8045/v1
PLANNER_MODEL=gemini-3.8-flash-medium
PLANNER_API_KEY=dummy-key
PLANNER_TIMEOUT=60

# Cloud Fallback (DashScope / Bailian):
# PLANNER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PLANNER_MODEL=qwen-plus-latest
# DASHSCOPE_API_KEY=your-api-key-here

# ===== Hard Budgets & Multi-Agent Safeguards (Ground Principles) =====
DEFAULT_MAX_AGENTS=3
DEFAULT_MAX_PARALLEL=3
DEFAULT_MAX_MODEL_CALLS=15
DEFAULT_MAX_TOTAL_TOKENS=100000

# ===== Adapter Matrix Gates =====
ENABLE_HERMES_ADAPTER=true
ENABLE_DSH_ADAPTER=true
ENABLE_ANTIGRAVITY_ADAPTER=true

# ===== Autonomous Evolution Sweeper =====
SWEEPER_ENABLED=true
SWEEPER_INTERVAL_SECONDS=300
